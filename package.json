{
  "name": "starcho-js",
  "productName": "Starcho JS",
  "desktopName": "starcho-js",
  "version": "2.0.0",
  "description": "Aplicación de notas de escritorio construida con Electron, Express 5 y SQLite.",
  "main": "main.js",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "start:production": "cross-env NODE_ENV=production electron .",
    "test": "node --test",
    "check": "node scripts/verify.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write scripts/verify.mjs test/**/*.js src/renderer/utils/fatalScreen.js .github/**/*.yml",
    "format:check": "prettier --check scripts/verify.mjs test/**/*.js src/renderer/utils/fatalScreen.js .github/**/*.yml",
    "ci": "npm run check && npm run lint && npm run format:check && npm test && npm audit --omit=dev --audit-level=high",
    "prepare": "husky",
    "build": "electron-builder",
    "build:win": "electron-builder --win --config.win.signExecutable=false",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.starcho.js",
    "productName": "Starcho JS",
    "copyright": "Copyright © 2026 Starcho JS",
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "artifactName": "Starcho-JS-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "plugins/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Office",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Starcho JS"
    },
    "dmg": {
      "title": "Starcho JS Installer",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "galax13a",
      "repo": "StarchoJsElectron",
      "releaseType": "release"
    }
  },
  "keywords": [
    "notes",
    "productivity",
    "electron"
  ],
  "author": {
    "name": "Starcho Dev",
    "email": "botcamdev@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "cross-env": "^10.1.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
